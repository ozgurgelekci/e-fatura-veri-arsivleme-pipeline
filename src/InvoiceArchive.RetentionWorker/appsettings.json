{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200"
  },
  "Storage": {
    "Provider": "MinIO",
    "ServiceUrl": "http://minio:9000",
    "Region": "us-east-1",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "ForcePathStyle": true
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "ClientId": "invoice-archive-retention-worker",
    "ConsumerGroupId": "invoice-archive-retention-worker",
    "ArchiveCreatedTopic": "invoice.archive.created",
    "ArchiveCompletedTopic": "invoice.archive.completed",
    "ArchiveFailedTopic": "invoice.archive.failed",
    "DeadLetterTopic": "invoice.archive.dlq"
  },
  "Persistence": {
    "Provider": "InMemory",
    "ConnectionString": null,
    "SchemaName": "public",
    "TableName": "archive_batches",
    "AutoMigrate": true
  },
  "Retention": {
    "Enabled": false,
    "IndexName": "invoices",
    "BucketName": "invoice-archive",
    "MinAgeAfterVerifiedDays": 30,
    "PollIntervalMinutes": 60,
    "BatchesPerRun": 50,
    "RequireS3ObjectExists": true,
    "DryRun": true
  },
  "Health": {
    "Port": 8082
  }
}
